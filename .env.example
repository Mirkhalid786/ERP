# =============================================================================
# Pharmacy ERP — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# MySQL Database
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=pharmacy_erp
MYSQL_USER=pharmacy_app
MYSQL_PASSWORD=change_this_app_password
MYSQL_PORT=3306

# Connection URL used by FastAPI / SQLAlchemy (inside Docker network)
DATABASE_URL=mysql+aiomysql://pharmacy_app:change_this_app_password@db:3306/pharmacy_erp

# Connection URL for Alembic migrations (sync driver)
DATABASE_URL_SYNC=mysql+pymysql://pharmacy_app:change_this_app_password@db:3306/pharmacy_erp

# Connection URL when running backend outside Docker (localhost)
DATABASE_URL_LOCAL=mysql+aiomysql://pharmacy_app:change_this_app_password@localhost:3306/pharmacy_erp
DATABASE_URL_LOCAL_SYNC=mysql+pymysql://pharmacy_app:change_this_app_password@localhost:3306/pharmacy_erp

# -----------------------------------------------------------------------------
# FastAPI application
# -----------------------------------------------------------------------------
# Environment: development | production
APP_ENV=development

# Secret key for session signing — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_HEX_STRING

# Session cookie settings
SESSION_COOKIE_NAME=pharmacy_session
SESSION_COOKIE_SECURE=false        # Set true in production with HTTPS
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=28800      # 8 hours

# CORS — comma-separated allowed origins (Next.js dev server)
CORS_ORIGINS=http://localhost:3000

# Host names the API accepts when APP_ENV=production (comma-separated). "backend" (the Docker service name
# the UI proxies to) is always accepted. Add the server name/IP only if clients call the API directly.
ALLOWED_HOSTS=localhost,127.0.0.1

# API host and port (inside Docker)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# -----------------------------------------------------------------------------
# Argon2id password hashing
# These are the recommended defaults. Only change after consulting the
# argon2-cffi documentation and benchmarking on target hardware.
# -----------------------------------------------------------------------------
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# -----------------------------------------------------------------------------
# Next.js frontend
# -----------------------------------------------------------------------------
# URL of the FastAPI backend as seen from the browser (LAN clients use the
# server's LAN IP, e.g. http://192.168.1.100:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal URL used by Next.js server-side API proxy (inside Docker network)
INTERNAL_API_URL=http://backend:8000

# -----------------------------------------------------------------------------
# First-run setup
# These are used only during the initial pharmacy setup wizard.
# Remove or clear them after setup is complete.
# -----------------------------------------------------------------------------
# FIRST_RUN_ADMIN_USERNAME=admin
# FIRST_RUN_ADMIN_PASSWORD=change_this_immediately

# -----------------------------------------------------------------------------
# Backup configuration
# -----------------------------------------------------------------------------
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Business time zone (Phase 4)
# Minutes east of UTC used for business dates (invoice day, due dates, day-end).
# India = 330 (+05:30). Timestamps are stored in UTC.
# -----------------------------------------------------------------------------
APP_UTC_OFFSET_MINUTES=330

# -----------------------------------------------------------------------------
# WhatsApp (Phase 4) — OPTIONAL
# Leave WHATSAPP_PROVIDER=manual to share invoices/reminders through WhatsApp
# click-to-chat links (staff press Send; no credentials needed).
# For the official WhatsApp Business Platform (Cloud API) set cloud_api and fill
# in the values from Meta Business Manager. Never commit real values.
# -----------------------------------------------------------------------------
WHATSAPP_PROVIDER=manual
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# App secret: verifies the X-Hub-Signature-256 header on incoming webhooks
WHATSAPP_APP_SECRET=
# Any random string; enter the same value in Meta's webhook settings
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Names of approved message templates (blank = plain text, which WhatsApp only
# delivers inside the 24-hour customer service window)
WHATSAPP_TEMPLATE_INVOICE=
WHATSAPP_TEMPLATE_REMINDER_UPCOMING=
WHATSAPP_TEMPLATE_REMINDER_DUE_TODAY=
WHATSAPP_TEMPLATE_REMINDER_OVERDUE=
# Attach the PDF invoice to Cloud API invoice messages
WHATSAPP_SEND_INVOICE_PDF=false

# -----------------------------------------------------------------------------
# Background worker (Phase 4)
# -----------------------------------------------------------------------------
WORKER_INTERVAL_SECONDS=60
WORKER_REMINDER_SCAN_MINUTES=60
